+    fn write_l3_domain_fixture(cache_path: &Path, cpu: usize, l3_domain: &str) {
+        fs::create_dir_all(cache_path).unwrap();
+        write_identity(cache_path, 0, 1, "Data", "64K");
+        write_identity(cache_path, 1, 1, "Instruction", "64K");
