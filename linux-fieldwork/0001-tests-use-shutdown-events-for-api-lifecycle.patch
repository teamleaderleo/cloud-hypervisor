From: Linux Fieldwork <noreply@example.invalid>
Subject: [PATCH] tests: use shutdown events for API lifecycle gates

The API shutdown and delete tests currently halt the guest and then treat an
unresponsive SSH service as proof that guest shutdown has completed. SSH can
disappear while other guest shutdown work is still running.

Start these VMMs with `--no-shutdown` and an event monitor. Power the guest
off normally, wait for the exact `shutdown` event, and only then exercise the
next API lifecycle transition. This preserves the VMM process while replacing
a service-level proxy with the VMM-owned state transition.

Addresses cloud-hypervisor#8046.
---
 cloud-hypervisor/tests/common/tests_wrappers.rs | 54 +++++++++++++++++---------
 1 file changed, 34 insertions(+), 20 deletions(-)

diff --git a/cloud-hypervisor/tests/common/tests_wrappers.rs b/cloud-hypervisor/tests/common/tests_wrappers.rs
--- a/cloud-hypervisor/tests/common/tests_wrappers.rs
+++ b/cloud-hypervisor/tests/common/tests_wrappers.rs
@@ -64,8 +64,11 @@
 // From the API: Create a VM, boot it and check it can be shutdown and then
 // booted again
 pub(crate) fn _test_api_shutdown(target_api: &TargetApi, guest: &Guest) {
+    let event_path = temp_event_monitor_path(&guest.tmp_dir);
     let mut child = GuestCommand::new(guest)
         .args(target_api.guest_args())
+        .args(["--no-shutdown"])
+        .args(["--event-monitor", format!("path={event_path}").as_str()])
         .capture_output()
         .spawn()
         .unwrap();
@@ -93,16 +96,20 @@
         guest.validate_cpu_count(None);
         guest.validate_memory(None);
 
-        // Sync and shutdown without powering off to prevent filesystem
-        // corruption.
-        guest.ssh_command("sync").unwrap();
-        guest.ssh_command("sudo shutdown -H now").unwrap();
-
-        // Wait for the guest to be fully shutdown
-        assert!(guest.wait_for_ssh_unresponsive(Duration::from_secs(20)));
-
-        // Then shut it down
-        assert!(target_api.remote_command("shutdown", None));
+        // Power off the guest normally. --no-shutdown keeps the VMM alive so
+        // the same VM can be used for the next lifecycle transition.
+        guest.ssh_command("sudo poweroff").unwrap();
+
+        // Wait for the VMM to report completed shutdown before reusing the VM.
+        let latest_events = [&MetaEvent {
+            event: "shutdown".to_string(),
+            device_id: None,
+        }];
+        assert!(wait_for_latest_events_exact(
+            Duration::from_secs(20),
+            &latest_events,
+            &event_path,
+        ));
 
         // Then boot it again
         assert!(target_api.remote_command("boot", None));
@@ -124,8 +131,11 @@
 // From the API: Create a VM, boot it and check it can be deleted and then recreated
 // booted again.
 pub(crate) fn _test_api_delete(target_api: &TargetApi, guest: &Guest) {
+    let event_path = temp_event_monitor_path(&guest.tmp_dir);
     let mut child = GuestCommand::new(guest)
         .args(target_api.guest_args())
+        .args(["--no-shutdown"])
+        .args(["--event-monitor", format!("path={event_path}").as_str()])
         .capture_output()
         .spawn()
         .unwrap();
@@ -153,13 +163,20 @@
         guest.validate_cpu_count(None);
         guest.validate_memory(None);
 
-        // Sync and shutdown without powering off to prevent filesystem
-        // corruption.
-        guest.ssh_command("sync").unwrap();
-        guest.ssh_command("sudo shutdown -H now").unwrap();
-
-        // Wait for the guest to be fully shutdown
-        assert!(guest.wait_for_ssh_unresponsive(Duration::from_secs(20)));
+        // Power off the guest normally. --no-shutdown keeps the VMM alive so
+        // the same process can service the following delete/create sequence.
+        guest.ssh_command("sudo poweroff").unwrap();
+
+        // Wait for the VMM to report completed shutdown before deleting the VM.
+        let latest_events = [&MetaEvent {
+            event: "shutdown".to_string(),
+            device_id: None,
+        }];
+        assert!(wait_for_latest_events_exact(
+            Duration::from_secs(20),
+            &latest_events,
+            &event_path,
+        ));
 
         // Then delete it
         assert!(target_api.remote_command("delete", None));
